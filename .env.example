# Public browser-safe Supabase values (use the publishable key, never the service-role key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only values: keep out of NEXT_PUBLIC_ variables and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random 32+ character secret (e.g. openssl rand -hex 32).
INQUIRY_RATE_LIMIT_SECRET=
# Absolute origin used for auth callbacks and metadata, e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
